{
  "name": "calendar-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node-pg-migrate -d NUXT_DATABASE_URL --envPath .env up",
    "migrate:down": "node-pg-migrate -d NUXT_DATABASE_URL --envPath .env down",
    "migrate:create": "node-pg-migrate -j sql create"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@mdi/font": "^7.4.47",
    "nuxt": "^4.4.2",
    "pg": "^8.20.0",
    "vue": "^3.5.32",
    "vuetify": "^3.12.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.4",
    "node-pg-migrate": "^8.0.4",
    "sass-embedded": "^1.99.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
